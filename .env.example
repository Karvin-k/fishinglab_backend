# 环境变量模板
# 复制成 .env 后填入你自己的值：cp .env.example .env

# ---- 数据库 ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fishing_shop_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# ---- Flask 密钥 ----
SECRET_KEY=your_secret_key_here

# ---- JWT 密钥（三套，互相独立）----
ADMIN_SECRET_KEY=your_admin_secret
ACCESS_SECRET_KEY=your_access_secret
USER_SECRET_KEY=your_user_secret

# ---- 演示用超级管理员（不配则不生效）----
DEMO_ADMIN_USER=
DEMO_ADMIN_PASS=

# ---- 微信小程序（用不到可留空）----
WX_APPID=
WX_SECRET=

# ---- 图片访问基础地址 ----
# 本地开发：http://localhost:5000
# 线上：http://你的IP 或 https://你的域名
STATIC_BASE_URL=http://localhost:5000

# ---- 调试 ----
FLASK_DEBUG=1
